# Core
NARI_ENV=development
NARI_APP_NAME=NARI
NARI_VERSION=1.0.0-alpha.11
NARI_SECRET_KEY=changeme-use-long-random-string

# Auth (Default: neural_link_established)
NARI_API_KEY=neural_link_established

# Database
DATABASE_URL=sqlite:///./data/nari.db

# Server
NARI_HOST=0.0.0.0                    # Listen on all interfaces
NARI_PORT=8000
NARI_WORKERS=1

# Logging
NARI_LOG_LEVEL=INFO

# User preferences
NARI_TIMEZONE=Asia/Kolkata
NARI_THEME=dark

# Scheduler
NARI_SCHEDULER_ENABLED=true

# AI (Stage 9)
NVIDIA_API_KEY=
AI_ENABLED=false
SEARXNG_URL=http://localhost:8080

# CORS: comma-separated list of ADDITIONAL allowed origins (beyond the defaults).
# Already hardcoded (no action needed): nari.local, nari.lan, nari.run.place, server-01.local, localhost
# Add origins here that change or are environment-specific (e.g. your ngrok tunnel URL).
# Example: NARI_ALLOWED_ORIGINS=https://uncover-patchwork-unedited.ngrok-free.dev
NARI_ALLOWED_ORIGINS=https://uncover-patchwork-unedited.ngrok-free.dev
