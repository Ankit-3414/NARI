# Core
NARI_ENV=development
NARI_APP_NAME=NARI
NARI_VERSION=0.1.0
NARI_SECRET_KEY=changeme-use-long-random-string

# Auth (Default: neural_link_established)
NARI_API_KEY=neural_link_established
NARI_SECRET_KEY=neural_link_secret_key_2026

# Database
DATABASE_URL=sqlite:///./data/nari.db

# Server
NARI_HOST=0.0.0.0                    # Listen on all interfaces
NARI_PORT=8000
NARI_WORKERS=1

# Logging
NARI_LOG_LEVEL=INFO

# User preferences
NARI_TIMEZONE=Asia/Kolkata
NARI_THEME=dark

# Scheduler
NARI_SCHEDULER_ENABLED=true

# AI reserved for Stage 9
NVIDIA_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_ENABLED=false
SEARXNG_URL=http://localhost:8080
